# Copy to apps/web/.env.local and fill locally. Never use NEXT_PUBLIC_ for secrets.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Optional discovery link to the separate Manufact MCP endpoint.
# MCP_PUBLIC_URL=https://YOUR_MANUFACT_ORIGIN/mcp
# Additional allowed browser origins, comma-separated; normally leave empty.
ALLOWED_ORIGINS=

# Supabase pooled Postgres URL; apply all supabase/migrations/*.sql in order.
DATABASE_URL=
# Base64 of the public Supabase CA PEM, used only for verified Postgres TLS.
DATABASE_CA_CERT_BASE64=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=mediapack-private

# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPABILITY_PEPPER=
WORKER_TOKEN_SECRET=
INTERNAL_TICK_TOKEN=

# Merchant account, sandbox only. Live keys/profiles are rejected in test mode.
PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PROFILE_ID=
# Optional for SDK test-card purchases only; rejected outside PAYMENTS_MODE=test.
# Link wallet purchases require a real profile_test_ identity instead.
STRIPE_TEST_NETWORK_ID=
STRIPE_WEBHOOK_SECRET=
# Optional stable signing key; otherwise derived from STRIPE_SECRET_KEY.
# MPP_SECRET_KEY=
STRIPE_TIMEOUT_MS=20000

# Org webhook receives both requests and worker replies at /webhooks/primitive.
PRIMITIVE_API_KEY=
PRIMITIVE_WEBHOOK_SECRET=
PRIMITIVE_CONTROL_ADDRESS=
PRIMITIVE_WORKER_ADDRESS=
PRIMITIVE_REQUIRE_SENDER_AUTH=false

# Blaxel workspace + deployed worker image. Projects BLAXEL_PLAN_* aliases are supported.
BL_API_KEY=
# Preferred hosted authentication: base64(client_id:client_secret), server only.
BL_CLIENT_CREDENTIALS=
BL_WORKSPACE=
BLAXEL_WORKER_IMAGE=
# Worker model/sending secrets are passed to the worker by the launch adapter.
PRIMITIVE_WORKER_API_KEY=
OPENAI_API_KEY=
# With a Blaxel gateway URL, the launcher supplies a short-lived model token.
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_SEARCH_MODEL=gpt-5.4-mini
OPENAI_ASR_MODEL=whisper-1

UNPAID_STORAGE_CAP_BYTES=2147483648
GLOBAL_CLIENTS_PER_HOUR=300
SOURCE_CLIENTS_PER_HOUR=20
WORKER_LEASE_SECONDS=1200
WORKER_TOKEN_TTL_SECONDS=1800
# Buyer-only values: export in the CLI terminal, never pass to workers.
# MEDIAPACK_URL=http://localhost:3000
# MEDIAPACK_CONFIG=/private/path/client.json
# MPPX_STRIPE_SECRET_KEY=sk_test_...

{
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["index.ts", "mcp-env.d.ts", "src/**/*", "views/**/*", "tests/**/*"],
  "exclude": ["node_modules", ".mcp-use"]
}

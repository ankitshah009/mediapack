{
  "name": "mediapack-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Manufact-hosted MCP proxy for the MediaPack Next.js API on Blaxel",
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "dev": "MCP_USE_ANONYMIZED_TELEMETRY=false mcp-use dev",
    "build": "MCP_USE_ANONYMIZED_TELEMETRY=false mcp-use build",
    "start": "MCP_USE_ANONYMIZED_TELEMETRY=false mcp-use start --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "MCP_USE_ANONYMIZED_TELEMETRY=false node --import tsx --test tests/*.test.ts",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "deploy": "mcp-use deploy"
  },
  "dependencies": {
    "mcp-use": "2.10.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.0.16"
  }
}

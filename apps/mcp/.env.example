# Canonical public origin of the Next.js dashboard + REST API hosted on Blaxel.
MEDIAPACK_API_URL=https://your-nextjs-app.example.com
# PUBLIC_BASE_URL is accepted as a fallback for MEDIAPACK_API_URL.
MEDIAPACK_API_TIMEOUT_MS=20000
# No capability or provider secret belongs here. Each MCP client supplies its own
# Authorization: Bearer <MediaPack capability> header.
